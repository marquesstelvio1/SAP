{
  "$schema": "plugin-registry-schema.json",
  "version": "1.0.0",
  "description": "Enterprise OpenCode Plugin Registry — all plugins available to agents",
  "plugins": [
    {
      "id": "context-loader",
      "name": "Context Loader",
      "version": "1.0.0",
      "kind": "system",
      "executionOrder": 0,
      "mandatory": true,
      "file": "context-loader.md",
      "runsOn": ["task-start", "session-start"],
      "agents": ["all"]
    },
    {
      "id": "orchestrator",
      "name": "Orchestrator",
      "version": "1.0.0",
      "kind": "system",
      "executionOrder": 1,
      "mandatory": true,
      "file": "orchestrator.md",
      "runsOn": ["task-start"],
      "agents": ["orchestrator"]
    },
    {
      "id": "product-design",
      "name": "Product Design",
      "version": "1.0.0",
      "kind": "governance",
      "executionOrder": 10,
      "mandatory": true,
      "file": "product-design.md",
      "runsOn": ["feature-start"],
      "agents": ["product-manager", "product-designer", "orchestrator"],
      "blocking": true
    },
    {
      "id": "architecture-audit",
      "name": "Architecture Audit",
      "version": "1.0.0",
      "kind": "governance",
      "executionOrder": 20,
      "mandatory": true,
      "file": "architecture-audit.md",
      "runsOn": ["pre-implementation", "post-implementation"],
      "agents": ["architect", "backend-architect", "frontend-architect"],
      "blocking": true
    },
    {
      "id": "design-system-audit",
      "name": "Design System Audit",
      "version": "1.0.0",
      "kind": "governance",
      "executionOrder": 25,
      "mandatory": true,
      "file": "design-system-audit.md",
      "runsOn": ["pre-frontend", "post-frontend"],
      "agents": ["design-system-architect", "frontend-architect"],
      "blocking": false
    },
    {
      "id": "shadcn-inspector",
      "name": "shadcn/ui Inspector",
      "version": "1.0.0",
      "kind": "validation",
      "executionOrder": 26,
      "mandatory": false,
      "file": "shadcn-inspector.md",
      "runsOn": ["pre-frontend", "post-frontend"],
      "agents": ["frontend-architect", "design-system-architect"],
      "blocking": false
    },
    {
      "id": "codebase-analysis",
      "name": "Codebase Analysis",
      "version": "1.0.0",
      "kind": "analysis",
      "executionOrder": 30,
      "mandatory": false,
      "file": "codebase-analysis.md",
      "runsOn": ["pre-implementation"],
      "agents": ["architect", "backend-architect", "frontend-architect"],
      "blocking": false
    },
    {
      "id": "dependency-inspector",
      "name": "Dependency Inspector",
      "version": "1.0.0",
      "kind": "analysis",
      "executionOrder": 35,
      "mandatory": false,
      "file": "dependency-inspector.md",
      "runsOn": ["pre-implementation", "post-implementation"],
      "agents": ["architect", "devops-architect"],
      "blocking": false
    },
    {
      "id": "monorepo-governance",
      "name": "Monorepo Governance",
      "version": "1.0.0",
      "kind": "governance",
      "executionOrder": 40,
      "mandatory": true,
      "file": "monorepo-governance.md",
      "runsOn": ["pre-implementation", "post-implementation"],
      "agents": ["architect", "devops-architect"],
      "blocking": true
    },
    {
      "id": "api-contract-validator",
      "name": "API Contract Validator",
      "version": "1.0.0",
      "kind": "validation",
      "executionOrder": 45,
      "mandatory": true,
      "file": "api-contract-validator.md",
      "runsOn": ["post-backend", "pre-frontend"],
      "agents": ["backend-architect", "frontend-architect"],
      "blocking": true
    },
    {
      "id": "frontend-backend-validator",
      "name": "Frontend-Backend Validator",
      "version": "1.0.0",
      "kind": "validation",
      "executionOrder": 50,
      "mandatory": true,
      "file": "frontend-backend-validator.md",
      "runsOn": ["post-implementation"],
      "agents": ["qa-architect", "frontend-architect", "backend-architect"],
      "blocking": true
    },
    {
      "id": "security-audit",
      "name": "Security Audit",
      "version": "1.0.0",
      "kind": "governance",
      "executionOrder": 60,
      "mandatory": true,
      "file": "security-audit.md",
      "runsOn": ["pre-release"],
      "agents": ["security-architect"],
      "blocking": true
    },
    {
      "id": "performance-audit",
      "name": "Performance Audit",
      "version": "1.0.0",
      "kind": "governance",
      "executionOrder": 65,
      "mandatory": true,
      "file": "performance-audit.md",
      "runsOn": ["pre-release"],
      "agents": ["performance-architect"],
      "blocking": false
    },
    {
      "id": "testing-audit",
      "name": "Testing Audit",
      "version": "1.0.0",
      "kind": "governance",
      "executionOrder": 55,
      "mandatory": true,
      "file": "testing-audit.md",
      "runsOn": ["post-implementation", "pre-release"],
      "agents": ["qa-architect"],
      "blocking": true
    },
    {
      "id": "accessibility-audit",
      "name": "Accessibility Audit",
      "version": "1.0.0",
      "kind": "governance",
      "executionOrder": 67,
      "mandatory": true,
      "file": "accessibility-audit.md",
      "runsOn": ["pre-release"],
      "agents": ["accessibility-architect"],
      "blocking": false
    },
    {
      "id": "ui-consistency",
      "name": "UI Consistency",
      "version": "1.0.0",
      "kind": "validation",
      "executionOrder": 27,
      "mandatory": false,
      "file": "ui-consistency.md",
      "runsOn": ["post-frontend"],
      "agents": ["design-system-architect", "frontend-architect"],
      "blocking": false
    },
    {
      "id": "enterprise-checklist",
      "name": "Enterprise Checklist",
      "version": "1.0.0",
      "kind": "governance",
      "executionOrder": 68,
      "mandatory": true,
      "file": "enterprise-checklist.md",
      "runsOn": ["pre-release"],
      "agents": ["architect", "qa-architect", "security-architect"],
      "blocking": true
    },
    {
      "id": "documentation-generator",
      "name": "Documentation Generator",
      "version": "1.0.0",
      "kind": "automation",
      "executionOrder": 70,
      "mandatory": true,
      "file": "documentation-generator.md",
      "runsOn": ["post-implementation", "pre-release"],
      "agents": ["documentation-architect"],
      "blocking": false
    },
    {
      "id": "release-readiness",
      "name": "Release Readiness",
      "version": "1.0.0",
      "kind": "governance",
      "executionOrder": 80,
      "mandatory": true,
      "file": "release-readiness.md",
      "runsOn": ["pre-release"],
      "agents": ["architect", "devops-architect", "qa-architect"],
      "blocking": true
    },
    {
      "id": "workflow-enforcer",
      "name": "Workflow Enforcer",
      "version": "1.0.0",
      "kind": "system",
      "executionOrder": 999,
      "mandatory": true,
      "file": "workflow-enforcer.md",
      "runsOn": ["always"],
      "agents": ["all"],
      "blocking": true
    }
  ],
  "workflowStages": [
    { "id": "context-load", "order": 0, "plugins": ["context-loader"] },
    { "id": "orchestrate", "order": 1, "plugins": ["orchestrator"] },
    { "id": "product-design", "order": 10, "plugins": ["product-design"] },
    { "id": "architecture", "order": 20, "plugins": ["architecture-audit", "codebase-analysis", "dependency-inspector", "monorepo-governance"] },
    { "id": "design-system", "order": 25, "plugins": ["design-system-audit", "shadcn-inspector", "ui-consistency"] },
    { "id": "contracts", "order": 45, "plugins": ["api-contract-validator"] },
    { "id": "integration", "order": 50, "plugins": ["frontend-backend-validator"] },
    { "id": "testing", "order": 55, "plugins": ["testing-audit"] },
    { "id": "security", "order": 60, "plugins": ["security-audit"] },
    { "id": "performance", "order": 65, "plugins": ["performance-audit"] },
    { "id": "accessibility", "order": 67, "plugins": ["accessibility-audit"] },
    { "id": "enterprise", "order": 68, "plugins": ["enterprise-checklist"] },
    { "id": "documentation", "order": 70, "plugins": ["documentation-generator"] },
    { "id": "release", "order": 80, "plugins": ["release-readiness"] },
    { "id": "enforce", "order": 999, "plugins": ["workflow-enforcer"] }
  ]
}
