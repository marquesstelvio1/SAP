{
  "name": "saptm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0 <26.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build --ui=stream",
    "typecheck": "turbo run typecheck --ui=stream",
    "lint": "biome check",
    "format": "biome format --write",
    "validate:foundation": "node scripts/validate-foundation.mjs",
    "validate:ui-foundation": "node scripts/validate-ui-foundation.mjs",
    "validate:tracking-foundation": "node scripts/validate-tracking-foundation.mjs",
    "validate:cargo-foundation": "node scripts/validate-cargo-foundation.mjs",
    "validate:capacity-foundation": "node scripts/validate-capacity-foundation.mjs",
    "validate:capacity-advisory": "node scripts/validate-capacity-advisory.mjs",
    "validate:tariff-foundation": "node scripts/validate-tariff-foundation.mjs",
    "validate:env": "tsx scripts/validate-env.ts",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "validate:containers": "node scripts/validate-containers.mjs",
    "validate:docker-runtime": "node scripts/validate-docker-runtime.mjs",
    "validate:deploy": "node scripts/validate-deploy.mjs",
    "validate:production-inputs": "node scripts/validate-production-inputs.mjs",
    "validate:production-handoff": "node scripts/validate-production-handoff.mjs",
    "validate:observability": "node scripts/validate-observability.mjs",
    "validate:alert-routing": "node scripts/validate-alert-routing.mjs",
    "validate:dr": "node scripts/validate-dr.mjs",
    "validate:tls": "node scripts/validate-tls.mjs",
    "validate:security-runtime": "node scripts/validate-security-runtime.mjs",
    "validate:secrets-network": "node scripts/validate-secrets-network.mjs",
    "validate:supply-chain": "node scripts/validate-supply-chain.mjs",
    "validate:resilience": "node scripts/validate-resilience.mjs",
    "validate:resource-governance": "node scripts/validate-resource-governance.mjs",
    "validate:cluster": "node scripts/validate-cluster.mjs",
    "validate:cluster-baseline-inputs": "node scripts/validate-cluster-baseline-inputs.mjs",
    "validate:local-readiness": "node scripts/validate-local-readiness.mjs",
    "validate:doc-freshness": "node scripts/validate-doc-freshness.mjs",
    "lint:unused-deps": "knip",
    "lint:a11y": "echo 'aXe scanning: run via Playwright (tests/e2e/accessibility.spec.ts)'",
    "validate:evidence": "node scripts/validate-evidence.mjs",
    "validate:local-production": "node scripts/run-local-production-validation.mjs",
    "evidence:release": "node scripts/generate-release-evidence.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:local-runtime": "node scripts/smoke-local-runtime.mjs",
    "test": "turbo run test --filter @saptm/api --filter @saptm/rpc --filter @saptm/ui --ui=stream",
    "test:coverage": "turbo run test:coverage --filter @saptm/api",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:load": "bash tests/load/run-load-tests.sh",
    "storybook": "pnpm --filter @saptm/ui storybook",
    "build:storybook": "pnpm --filter @saptm/ui build:storybook",
    "changeset": "changeset",
    "ci:gate": "node scripts/ci-gate.mjs --full",
    "ci:gate:precommit": "node scripts/ci-gate.mjs",
    "db:generate": "pnpm --filter @saptm/database db:generate",
    "db:validate": "pnpm --filter @saptm/database db:validate",
    "db:migrate:dev": "pnpm --filter @saptm/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @saptm/database db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @saptm/database db:migrate:status",
    "db:migrate:rollback": "pnpm --filter @saptm/database db:migrate:rollback",
    "db:seed": "pnpm --filter @saptm/database db:seed",
    "auth:seed-local-admin": "pnpm --filter @saptm/auth seed:local-admin",
    "worker:outbox": "pnpm --filter @saptm/api worker:outbox",
    "db:studio": "pnpm --filter @saptm/database db:studio",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "infra:up": "docker compose up -d postgres redis",
    "infra:stack": "docker compose up -d --build",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "postinstall": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'pipe'})}catch(e){}\"",
    "docker:api:build": "docker build -f apps/api/Dockerfile -t saptm-api .",
    "docker:web:build": "docker build -f apps/web/Dockerfile -t saptm-web ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@axe-core/playwright": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "@next/bundle-analyzer": "catalog:",
    "turbo": "catalog:",
    "knip": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:"
  },
  "onlyBuiltDependencies": [
    "@nestjs/core",
    "@prisma/client",
    "@prisma/engines",
    "esbuild",
    "prisma",
    "sharp"
  ],
  "dependencies": {
    "class-variance-authority": "catalog:",
    "radix-ui": "catalog:"
  }
}
