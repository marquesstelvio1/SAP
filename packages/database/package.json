{
  "name": "@saptm/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/patch-esm-dist-extensions.mjs dist/src/index.js audit rbac-bootstrap outbox-event-bus domain-events constants prisma/factory && node ../../scripts/patch-prisma-esm-imports.mjs && node ../../scripts/create-prisma-shim.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "echo 'No tests yet'",
    "db:validate": "npx --no prisma validate",
    "db:generate": "NPM_CONFIG_loglevel=error npx --no prisma generate",
    "db:migrate:dev": "npx --no prisma migrate dev",
    "db:migrate:deploy": "npx --no prisma migrate deploy",
    "db:migrate:status": "npx --no prisma migrate status",
    "db:migrate:rollback": "node scripts/rollback-migration.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:users": "tsx prisma/seed-users.ts",
    "db:studio": "npx --no prisma studio",
    "validate:migrations": "node ../../scripts/validate-migrations.mjs",
    "worker:outbox": "echo 'Outbox worker disabled'"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "dotenv": "catalog:",
    "@saptm/config": "workspace:*",
    "@saptm/email": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "better-auth": "catalog:",
    "prisma": "catalog:",
    "@saptm/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
