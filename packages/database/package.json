{
  "name": "@saptm/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/patch-esm-dist-extensions.mjs dist/index.js audit rbac-bootstrap",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "validate:migrations": "node ../../scripts/validate-migrations.mjs",
    "worker:outbox": "node scripts/process-outbox.mjs"
  },
  "dependencies": {
    "@prisma/client": "catalog:",
    "@saptm/config": "workspace:*",
    "@saptm/observability": "workspace:*"
  },
  "devDependencies": {
    "@saptm/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
