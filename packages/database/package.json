{
  "name": "@saptm/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup ././src/index.ts --format esm --dts --sourcemap --clean --target es2022",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "catalog:",
    "@saptm/config": "workspace:*",
    "@saptm/observability": "workspace:*"
  },
  "devDependencies": {
    "@saptm/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "prisma": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
