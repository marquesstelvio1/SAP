generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  active
  suspended
  archived
}

enum MembershipStatus {
  invited
  active
  suspended
  removed
}

enum ActorType {
  anonymous
  user
  service_account
  integration
  platform
  ai_agent
}

enum AuditSeverity {
  low
  medium
  high
  critical
}

enum OutboxEventStatus {
  pending
  processing
  published
  failed
}

enum NotificationStatus {
  unread
  read
  archived
}

enum TrackingShipmentStatus {
  planned
  in_transit
  delayed
  exception
  arrived
  completed
  cancelled
}

enum TrackingTransportMode {
  rail
  port
  road
  multimodal
}

enum TrackingEventType {
  created
  departed
  arrived
  delayed
  exception
  location_updated
  handover_completed
  customs_hold
  released
}

enum CargoStatus {
  registered
  ready_for_transport
  in_transport
  held
  delivered
  cancelled
}

enum CargoType {
  container
  bulk
  break_bulk
  liquid_bulk
  refrigerated
  hazardous
  vehicle
  other
}

enum CargoCustomsStatus {
  not_required
  pending
  cleared
  held
}

enum CargoConditionStatus {
  sound
  damaged
  requires_inspection
}

enum CargoDeliveryExceptionType {
  damage
  shortage
  temperature_excursion
  documentation_mismatch
  security_seal_breach
  other
}

enum CargoDeliveryExceptionStatus {
  open
  resolved
}

enum CargoDeliveryExceptionResolutionCode {
  inspection_passed
  claim_accepted
  waiver_approved
  recovered
  other
}

enum CargoOperationalHandoffType {
  rail_to_port
  port_to_rail
  terminal_to_carrier
  carrier_to_terminal
  yard_transfer
  customs_to_operations
  other
}

enum CargoClaimSettlementType {
  carrier_liability
  insurance_recovery
  customer_credit
  supplier_recovery
  write_off
  other
}

enum CargoClaimSettlementStatus {
  settled
}

enum CapacityResourceType {
  terminal
  gate
  berth
  rail_track
  yard
  carrier_slot
}

enum CapacitySlotStatus {
  open
  blocked
  closed
}

enum CapacityReservationPurpose {
  handoff
  departure
  arrival
  delivery
  storage
  other
}

enum CapacityReservationStatus {
  reserved
  cancelled
}

enum CapacityAdvisoryRecommendationType {
  slot_saturation
  expiring_slot
  unused_capacity
  reservation_imbalance
  cancellation_review
}

enum CapacityAdvisoryDecisionStatus {
  approved
  rejected
}

enum TransportOrderStatus {
  confirmed
  cancelled
}

enum TransportOrderMode {
  rail
  road
  sea
  barge
  multimodal
}

enum TariffRateCardStatus {
  draft
  active
  retired
}

enum TariffChargeType {
  freight
  handling
  storage
  demurrage
  surcharge
  discount
  customs
  insurance
  other
}

enum TariffCalculationBasis {
  flat
  per_unit
  per_weight_kg
  per_volume_m3
  per_distance_km
  percentage
}

enum TariffQuoteStatus {
  calculated
  approved
  rejected
  expired
}

enum CargoComplianceEvidenceType {
  bill_of_lading
  customs_declaration
  inspection_certificate
  hazardous_goods_declaration
  packing_list
  insurance_certificate
  release_authorization
  other
}

enum CargoComplianceEvidenceStatus {
  pending_review
  approved
  rejected
}

model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  image            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lockedUntil     DateTime?
  loginAttempts   LoginAttempt[]
  sessions        Session[]
  accounts        Account[]
  twoFactors      TwoFactor[]
  memberships     Membership[]
  teamMemberships TeamMember[]
}

model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  userId      String
  verified    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(active)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?
  deletedBy String?

  @@index([status, deletedAt])

  memberships                     Membership[]
  roles                           Role[]
  auditRecords                    AuditRecord[]
  outboxEvents                    OutboxEvent[]
  notifications                   Notification[]
  serviceAccounts                 ServiceAccount[]
  integrationEvents               IntegrationEvent[]
  cargoRecords                    Cargo[]
  cargoOperationalHandoffs        CargoOperationalHandoff[]
  cargoClaimSettlements           CargoClaimSettlement[]
  cargoComplianceEvidences        CargoComplianceEvidence[]
  cargoDeliveryExceptions         CargoDeliveryException[]
  capacityResources               CapacityResource[]
  capacitySlots                   CapacitySlot[]
  capacityReservations            CapacitySlotReservation[]
  capacityAdvisoryDecisions       CapacityAdvisoryDecision[]
  transportOrders                 TransportOrder[]
  transportOrderScheduleRevisions TransportOrderScheduleRevision[]
  transportOrderDispatches        TransportOrderDispatch[]
  tariffRateCards                 TariffRateCard[]
  tariffRateRules                 TariffRateRule[]
  tariffQuotes                    TariffQuote[]
  trackingShipments               TrackingShipment[]
  trackingEvents                  TrackingEvent[]
  teams                           Team[]
  subscription                    Subscription?
  invoices                        Invoice[]
  usageRecords                    UsageRecord[]
  webhookEndpoints                WebhookEndpoint[]
  ssoConfigs                      SsoConfig[]
}

model Team {
  id             String       @id @default(cuid())
  name           String
  description    String?
  slug           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  members            TeamMember[]
  cargos             Cargo[]
  trackingShipments  TrackingShipment[]
  createdAt          DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("teams")
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  role   String @default("member") // "admin" | "member" | "viewer"
  team   Team   @relation(fields: [teamId], references: [id], onDelete: NoAction)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  status         MembershipStatus @default(invited)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model Role {
  id             String    @id @default(cuid())
  organizationId String?
  key            String
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model MembershipRole {
  membershipId String
  roleId       String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
}

model AuditRecord {
  id             String        @id @default(cuid())
  organizationId String?
  actorType      ActorType
  actorId        String?
  action         String
  subjectType    String
  subjectId      String?
  severity       AuditSeverity @default(medium)
  before         Json?
  after          Json?
  reason         String?
  ipAddress      String?
  userAgent      String?
  correlationId  String
  createdAt      DateTime      @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, subjectType, subjectId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([correlationId])
}

model ServiceAccount {
  id                      String    @id @default(cuid())
  organizationId          String
  name                    String
  scopes                  String[]
  active                  Boolean   @default(true)
  createdByActorId        String?
  provisionIdempotencyKey String?
  lastRotatedAt           DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?
  deletedBy               String?

  apiKeys           ApiKey[]
  integrationEvents IntegrationEvent[]
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@unique([organizationId, provisionIdempotencyKey])
  @@index([organizationId, active])
}

model ApiKey {
  id               String    @id @default(cuid())
  serviceAccountId String
  keyHash          String    @unique
  prefix           String
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  serviceAccount ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  @@index([serviceAccountId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model IntegrationEvent {
  id               String          @id @default(cuid())
  organizationId   String?
  serviceAccountId String?
  sourceSystem     String
  externalId       String
  eventType        String
  payload          Json
  receivedAt       DateTime        @default(now())
  processedAt      DateTime?
  deletedAt        DateTime?
  deletedBy        String?
  organization     Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  serviceAccount   ServiceAccount? @relation(fields: [serviceAccountId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sourceSystem, externalId])
  @@index([organizationId, eventType, receivedAt])
  @@index([serviceAccountId, receivedAt])
}

model OutboxEvent {
  id             String            @id @default(cuid())
  organizationId String?
  eventType      String
  aggregateType  String
  aggregateId    String
  eventVersion   Int               @default(1)
  payload        Json
  status         OutboxEventStatus @default(pending)
  attempts       Int               @default(0)
  availableAt    DateTime          @default(now())
  createdAt      DateTime          @default(now())
  publishedAt    DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  notification Notification?

  @@index([status, availableAt])
  @@index([organizationId, eventType, createdAt])
  @@index([eventType, createdAt])
}

model Notification {
  id                  String             @id @default(cuid())
  organizationId      String?
  sourceOutboxEventId String?            @unique
  eventType           String
  aggregateType       String
  aggregateId         String
  title               String
  message             String
  severity            AuditSeverity      @default(medium)
  status              NotificationStatus @default(unread)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  deletedBy           String?
  readAt              DateTime?
  archivedAt          DateTime?

  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sourceOutboxEvent OutboxEvent? @relation(fields: [sourceOutboxEventId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, eventType, createdAt])
  @@index([aggregateType, aggregateId])
}

model Cargo {
  id                          String               @id @default(cuid())
  organizationId              String
  teamId                      String?
  cargoReference              String
  externalReference           String?
  cargoDescription            String
  cargoType                   CargoType
  status                      CargoStatus          @default(registered)
  customsStatus               CargoCustomsStatus   @default(pending)
  customsReference            String?
  conditionStatus             CargoConditionStatus @default(sound)
  grossWeightKg               Decimal              @db.Decimal(12, 3)
  packageCount                Int
  volumeM3                    Decimal?             @db.Decimal(12, 3)
  hazardous                   Boolean              @default(false)
  unNumber                    String?
  hazardClass                 String?
  requiresInspection          Boolean              @default(false)
  shipperName                 String
  consigneeName               String
  originName                  String
  destinationName             String
  custodyOwnerName            String
  priority                    Int                  @default(3)
  expectedReadyAt             DateTime?
  sourceSystem                String               @default("saptm")
  registrationIdempotencyKey  String?
  releaseIdempotencyKey       String?
  releaseReference            String?
  releaseReason               String?
  transportPlanIdempotencyKey String?
  departureIdempotencyKey     String?
  arrivalIdempotencyKey       String?
  deliveryIdempotencyKey      String?
  transportPlanningReference  String?
  transportOwnerTeam          String?
  departureReference          String?
  departureLocationName       String?
  departureOperatorName       String?
  carrierReference            String?
  arrivalReference            String?
  arrivalLocationName         String?
  arrivalOperatorName         String?
  deliveryReference           String?
  receivedByName              String?
  deliveryNotes               String?
  trackingShipmentId          String?
  registeredAt                DateTime             @default(now())
  releasedAt                  DateTime?
  transportPlannedAt          DateTime?
  departedAt                  DateTime?
  arrivedAt                   DateTime?
  deliveredAt                 DateTime?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  deletedAt                   DateTime?
  deletedBy                   String?

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  team                 Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  // Logical reference to TrackingShipment (no FK constraint for bounded context decoupling)
  complianceEvidences  CargoComplianceEvidence[]
  operationalHandoffs  CargoOperationalHandoff[]
  deliveryExceptions   CargoDeliveryException[]
  claimSettlements     CargoClaimSettlement[]
  capacityReservations CapacitySlotReservation[]
  transportOrders      TransportOrder[]
  tariffQuotes         TariffQuote[]
  trackingShipments    TrackingShipment[]

  @@unique([organizationId, cargoReference])
  @@unique([organizationId, registrationIdempotencyKey])
  @@unique([organizationId, releaseIdempotencyKey])
  @@unique([organizationId, transportPlanIdempotencyKey])
  @@unique([organizationId, departureIdempotencyKey])
  @@unique([organizationId, arrivalIdempotencyKey])
  @@unique([organizationId, deliveryIdempotencyKey])
  @@unique([trackingShipmentId])
  @@index([organizationId, status, expectedReadyAt])
  @@index([organizationId, status, releasedAt])
  @@index([organizationId, status, departedAt])
  @@index([organizationId, status, arrivedAt])
  @@index([organizationId, status, deliveredAt])
  @@index([organizationId, trackingShipmentId])
  @@index([organizationId, teamId])
  @@index([organizationId, teamId, status])
  @@index([organizationId, cargoType, status])
  @@index([organizationId, customsStatus, conditionStatus])
}

model CargoDeliveryException {
  id                      String                                @id @default(cuid())
  organizationId          String
  cargoId                 String
  trackingShipmentId      String?
  exceptionType           CargoDeliveryExceptionType
  deliveryConditionStatus CargoConditionStatus
  status                  CargoDeliveryExceptionStatus          @default(open)
  reportedByName          String
  exceptionSummary        String
  evidenceReference       String
  claimReference          String?
  occurredAt              DateTime
  resolverName            String?
  resolutionCode          CargoDeliveryExceptionResolutionCode?
  resolutionReference     String?
  resolutionSummary       String?
  resolvedAt              DateTime?
  sourceSystem            String                                @default("saptm")
  recordIdempotencyKey    String?
  resolveIdempotencyKey   String?
  createdAt               DateTime                              @default(now())
  updatedAt               DateTime                              @updatedAt
  deletedAt               DateTime?
  deletedBy               String?

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  cargo           Cargo                 @relation(fields: [cargoId], references: [id], onDelete: NoAction)
  claimSettlement CargoClaimSettlement?

  @@unique([organizationId, recordIdempotencyKey])
  @@unique([organizationId, resolveIdempotencyKey])
  @@index([organizationId, cargoId, status])
  @@index([organizationId, exceptionType, status])
  @@index([organizationId, occurredAt])
}

model CargoClaimSettlement {
  id                   String                     @id @default(cuid())
  organizationId       String
  cargoId              String
  deliveryExceptionId  String                     @unique
  claimReference       String
  settlementReference  String
  settlementType       CargoClaimSettlementType
  settlementStatus     CargoClaimSettlementStatus @default(settled)
  currencyCode         String
  settlementAmount     Decimal                    @db.Decimal(14, 2)
  settledByName        String
  counterpartyName     String
  settlementSummary    String
  settledAt            DateTime
  sourceSystem         String                     @default("saptm")
  recordIdempotencyKey String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  deletedAt            DateTime?
  deletedBy            String?

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  cargo             Cargo                  @relation(fields: [cargoId], references: [id], onDelete: NoAction)
  deliveryException CargoDeliveryException @relation(fields: [deliveryExceptionId], references: [id], onDelete: NoAction)

  @@unique([organizationId, recordIdempotencyKey])
  @@unique([organizationId, settlementReference])
  @@unique([organizationId, deliveryExceptionId])
  @@index([organizationId, cargoId, settledAt])
  @@index([organizationId, settlementType, settledAt])
}

model CapacityResource {
  id                    String               @id @default(cuid())
  organizationId        String
  resourceCode          String
  resourceName          String
  resourceType          CapacityResourceType
  locationName          String
  maxConcurrentBookings Int
  sourceSystem          String               @default("saptm")
  recordIdempotencyKey  String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  deletedBy             String?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  slots        CapacitySlot[]

  @@unique([organizationId, recordIdempotencyKey])
  @@unique([organizationId, resourceCode])
  @@index([organizationId, resourceType, locationName])
}

model CapacitySlot {
  id                   String             @id @default(cuid())
  organizationId       String
  resourceId           String
  slotReference        String
  windowStartAt        DateTime
  windowEndAt          DateTime
  capacityUnits        Int
  reservedUnits        Int                @default(0)
  status               CapacitySlotStatus @default(open)
  sourceSystem         String             @default("saptm")
  recordIdempotencyKey String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  deletedBy            String?

  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  resource          CapacityResource           @relation(fields: [resourceId], references: [id], onDelete: NoAction)
  reservations      CapacitySlotReservation[]
  advisoryDecisions CapacityAdvisoryDecision[]

  @@unique([organizationId, recordIdempotencyKey])
  @@unique([organizationId, slotReference])
  @@index([organizationId, resourceId, windowStartAt])
  @@index([organizationId, status, windowStartAt])
}

model CapacitySlotReservation {
  id                    String                     @id @default(cuid())
  organizationId        String
  cargoId               String
  slotId                String
  reservationReference  String
  reservationPurpose    CapacityReservationPurpose
  status                CapacityReservationStatus  @default(reserved)
  reservedUnits         Int
  reservedByName        String
  reservedAt            DateTime
  cancellationReference String?
  cancelledByName       String?
  cancellationReason    String?
  cancelledAt           DateTime?
  sourceSystem          String                     @default("saptm")
  reserveIdempotencyKey String?
  cancelIdempotencyKey  String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  deletedAt             DateTime?
  deletedBy             String?

  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  cargo             Cargo                      @relation(fields: [cargoId], references: [id], onDelete: NoAction)
  slot              CapacitySlot               @relation(fields: [slotId], references: [id], onDelete: NoAction)
  advisoryDecisions CapacityAdvisoryDecision[]
  transportOrders   TransportOrder[]

  @@unique([organizationId, reserveIdempotencyKey])
  @@unique([organizationId, cancelIdempotencyKey])
  @@unique([organizationId, reservationReference])
  @@unique([organizationId, cargoId, slotId, reservationPurpose])
  @@index([organizationId, cargoId, status])
  @@index([organizationId, slotId, status])
  @@index([organizationId, status, reservedAt])
}

model CapacityAdvisoryDecision {
  id                     String                             @id @default(cuid())
  organizationId         String
  recommendationId       String
  recommendationType     CapacityAdvisoryRecommendationType
  decisionStatus         CapacityAdvisoryDecisionStatus
  decidedByName          String
  decisionReason         String
  approvalReference      String?
  requiredPermission     String
  slotId                 String?
  reservationId          String?
  sourceSystem           String                             @default("saptm")
  decisionIdempotencyKey String?
  decidedAt              DateTime
  createdAt              DateTime                           @default(now())
  updatedAt              DateTime                           @updatedAt
  deletedAt              DateTime?
  deletedBy              String?

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  slot         CapacitySlot?            @relation(fields: [slotId], references: [id], onDelete: SetNull)
  reservation  CapacitySlotReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, decisionIdempotencyKey])
  @@unique([organizationId, recommendationId])
  @@index([organizationId, decisionStatus, decidedAt])
  @@index([organizationId, recommendationType, decidedAt])
  @@index([organizationId, slotId, decidedAt])
  @@index([organizationId, reservationId, decidedAt])
}

model TransportOrder {
  id                     String               @id @default(cuid())
  organizationId         String
  cargoId                String
  trackingShipmentId     String?
  capacityReservationId  String?
  orderReference         String
  status                 TransportOrderStatus @default(confirmed)
  mode                   TransportOrderMode
  carrierName            String
  routeSummary           String
  originName             String
  destinationName        String
  plannedDepartureAt     DateTime
  plannedArrivalAt       DateTime
  responsiblePlannerName String
  confirmationReference  String
  sourceSystem           String               @default("saptm")
  confirmIdempotencyKey  String?
  confirmedAt            DateTime
  cancellationReference  String?
  cancelledByName        String?
  cancellationReason     String?
  cancelIdempotencyKey   String?
  cancelledAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
  deletedBy              String?

  organization        Organization                     @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  cargo               Cargo                            @relation(fields: [cargoId], references: [id], onDelete: NoAction)
  // Logical reference to TrackingShipment (no FK constraint for bounded context decoupling)
  capacityReservation CapacitySlotReservation?         @relation(fields: [capacityReservationId], references: [id], onDelete: SetNull)
  scheduleRevisions   TransportOrderScheduleRevision[]
  dispatches          TransportOrderDispatch[]
  // Logical reference to TrackingShipment (no FK constraint for bounded context decoupling)

  @@unique([organizationId, confirmIdempotencyKey])
  @@unique([organizationId, cancelIdempotencyKey])
  @@unique([organizationId, orderReference])
  @@unique([organizationId, cancellationReference])
  @@unique([organizationId, cargoId])
  @@index([organizationId, status, plannedDepartureAt])
  @@index([organizationId, mode, plannedDepartureAt])
  @@index([organizationId, trackingShipmentId])
  @@index([organizationId, capacityReservationId])
}

model TransportOrderDispatch {
  id                   String    @id @default(cuid())
  organizationId       String
  orderId              String
  dispatchReference    String
  dispatchedByName     String
  dispatchInstructions String
  sourceSystem         String    @default("saptm")
  idempotencyKey       String
  dispatchedAt         DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  deletedBy            String?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  transportOrder TransportOrder @relation(fields: [orderId], references: [id], onDelete: NoAction)

  @@unique([organizationId, dispatchReference])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, orderId])
  @@index([organizationId, dispatchedAt])
}

model TransportOrderScheduleRevision {
  id                         String             @id @default(cuid())
  organizationId             String
  orderId                    String
  revisionReference          String
  previousMode               TransportOrderMode
  newMode                    TransportOrderMode
  previousCarrierName        String
  newCarrierName             String
  previousRouteSummary       String
  newRouteSummary            String
  previousOriginName         String
  newOriginName              String
  previousDestinationName    String
  newDestinationName         String
  previousPlannedDepartureAt DateTime
  newPlannedDepartureAt      DateTime
  previousPlannedArrivalAt   DateTime
  newPlannedArrivalAt        DateTime
  rescheduledByName          String
  rescheduleReason           String
  sourceSystem               String             @default("saptm")
  idempotencyKey             String
  rescheduledAt              DateTime
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  deletedAt                  DateTime?
  deletedBy                  String?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  transportOrder TransportOrder @relation(fields: [orderId], references: [id], onDelete: NoAction)

  @@unique([organizationId, revisionReference])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, orderId, rescheduledAt])
}

model TariffRateCard {
  id                   String               @id @default(cuid())
  organizationId       String
  rateCardCode         String
  rateCardName         String
  status               TariffRateCardStatus @default(active)
  currencyCode         String
  validFrom            DateTime
  validUntil           DateTime?
  sourceSystem         String               @default("saptm")
  recordIdempotencyKey String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  deletedBy            String?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  rules        TariffRateRule[]
  quotes       TariffQuote[]

  @@unique([organizationId, recordIdempotencyKey])
  @@unique([organizationId, rateCardCode])
  @@index([organizationId, status, currencyCode])
  @@index([organizationId, validFrom, validUntil])
}

model TariffRateRule {
  id                   String                 @id @default(cuid())
  organizationId       String
  rateCardId           String
  ruleCode             String
  chargeName           String
  chargeType           TariffChargeType
  calculationBasis     TariffCalculationBasis
  unitRate             Decimal?               @db.Decimal(14, 4)
  flatAmount           Decimal?               @db.Decimal(14, 2)
  percentageRate       Decimal?               @db.Decimal(8, 4)
  minimumCharge        Decimal?               @db.Decimal(14, 2)
  originName           String?
  destinationName      String?
  cargoType            CargoType?
  effectiveFrom        DateTime
  effectiveUntil       DateTime?
  sourceSystem         String                 @default("saptm")
  recordIdempotencyKey String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  deletedBy            String?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  rateCard     TariffRateCard @relation(fields: [rateCardId], references: [id], onDelete: NoAction)

  @@unique([organizationId, recordIdempotencyKey])
  @@unique([organizationId, rateCardId, ruleCode])
  @@index([organizationId, rateCardId, chargeType])
  @@index([organizationId, cargoType, chargeType])
  @@index([organizationId, effectiveFrom, effectiveUntil])
}

model TariffQuote {
  id                      String            @id @default(cuid())
  organizationId          String
  cargoId                 String
  rateCardId              String
  quoteReference          String
  status                  TariffQuoteStatus @default(calculated)
  currencyCode            String
  quotedAmount            Decimal           @db.Decimal(14, 2)
  calculationPayload      Json
  calculatedByName        String
  calculatedAt            DateTime
  approvedByName          String?
  approvalReference       String?
  approvalNotes           String?
  approvedAt              DateTime?
  sourceSystem            String            @default("saptm")
  calculateIdempotencyKey String?
  approveIdempotencyKey   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  deletedAt               DateTime?
  deletedBy               String?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  cargo        Cargo          @relation(fields: [cargoId], references: [id], onDelete: NoAction)
  rateCard     TariffRateCard @relation(fields: [rateCardId], references: [id], onDelete: NoAction)

  @@unique([organizationId, calculateIdempotencyKey])
  @@unique([organizationId, approveIdempotencyKey])
  @@unique([organizationId, quoteReference])
  @@index([organizationId, cargoId, status])
  @@index([organizationId, rateCardId, status])
  @@index([organizationId, status, calculatedAt])
}

model CargoOperationalHandoff {
  id                   String                      @id @default(cuid())
  organizationId       String
  cargoId              String
  trackingShipmentId   String?
  handoffType          CargoOperationalHandoffType
  fromCustodyOwnerName String
  toCustodyOwnerName   String
  handoffLocationName  String
  operatorName         String
  handoffReference     String
  sealReference        String?
  conditionStatus      CargoConditionStatus        @default(sound)
  handoffNotes         String?
  handoffAt            DateTime
  sourceSystem         String                      @default("saptm")
  recordIdempotencyKey String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  deletedAt            DateTime?
  deletedBy            String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  cargo        Cargo        @relation(fields: [cargoId], references: [id], onDelete: NoAction)

  @@unique([organizationId, recordIdempotencyKey])
  @@unique([organizationId, handoffReference])
  @@index([organizationId, cargoId, handoffAt])
  @@index([organizationId, handoffType, handoffAt])
}

model CargoComplianceEvidence {
  id                   String                        @id @default(cuid())
  organizationId       String
  cargoId              String
  evidenceType         CargoComplianceEvidenceType
  documentReference    String
  documentTitle        String
  documentUri          String?
  issuerName           String
  issuedAt             DateTime?
  expiresAt            DateTime?
  status               CargoComplianceEvidenceStatus @default(pending_review)
  reviewerName         String?
  reviewReference      String?
  reviewSummary        String?
  rejectionReason      String?
  reviewedAt           DateTime?
  sourceSystem         String                        @default("saptm")
  recordIdempotencyKey String?
  verifyIdempotencyKey String?
  recordedByActorId    String
  reviewedByActorId    String?
  recordedAt           DateTime                      @default(now())
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  deletedAt            DateTime?
  deletedBy            String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  cargo        Cargo        @relation(fields: [cargoId], references: [id], onDelete: NoAction)

  @@unique([organizationId, recordIdempotencyKey])
  @@unique([organizationId, verifyIdempotencyKey])
  @@unique([organizationId, cargoId, evidenceType, documentReference])
  @@index([organizationId, cargoId, status])
  @@index([organizationId, evidenceType, status])
  @@index([organizationId, expiresAt])
}

model TrackingShipment {
  id                 String                 @id @default(cuid())
  organizationId     String
  teamId             String?
  referenceCode      String
  externalReference  String?
  cargoDescription   String
  originName         String
  destinationName    String
  transportMode      TrackingTransportMode
  status             TrackingShipmentStatus @default(planned)
  priority           Int                    @default(3)
  plannedDepartureAt DateTime?
  estimatedArrivalAt DateTime?
  actualArrivalAt    DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  deletedBy          String?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  team            Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  events          TrackingEvent[]
  cargo           Cargo?           @relation(fields: [cargoId], references: [id])
  cargoId         String?

  @@unique([organizationId, referenceCode])
  @@index([organizationId, teamId])
  @@index([organizationId, teamId, status])
  @@index([organizationId, status, estimatedArrivalAt])
  @@index([organizationId, transportMode, status])
  @@index([organizationId, externalReference])
}

model WebhookEndpoint {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  name            String
  url             String
  secret          String?
  events          String[]
  isActive        Boolean      @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  deletedBy       String?

  deliveries WebhookDelivery[]

  @@index([organizationId, isActive])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String          @id @default(cuid())
  webhookId    String
  webhook      WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: NoAction)
  eventType    String
  payload      Json
  status       String          @default("pending")
  statusCode   Int?
  responseBody String?
  attemptCount Int             @default(0)
  nextRetryAt  DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  deletedBy    String?

  @@index([webhookId])
  @@index([status])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

model TrackingEvent {
  id             String            @id @default(cuid())
  organizationId String
  shipmentId     String
  eventType      TrackingEventType
  occurredAt     DateTime
  locationName   String?
  notes          String?
  payload        Json?
  sourceSystem   String            @default("saptm")
  correlationId  String
  idempotencyKey String?
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?
  deletedBy      String?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  shipment     TrackingShipment @relation(fields: [shipmentId], references: [id], onDelete: NoAction)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, eventType, occurredAt])
  @@index([shipmentId, occurredAt])
  @@index([correlationId])
}

model Plan {
  id            String    @id @default(cuid())
  slug          String    @unique       // "free", "pro", "enterprise"
  name          String                  // "Free", "Pro", "Enterprise"
  description   String?
  price         Int       @default(0)   // Price in cents
  currency      String    @default("eur")
  interval      String    @default("month") // "month" | "year"
  features      Json      @default("[]")    // Feature flag keys
  limits        Json      @default("{}")    // Plan limits as JSON
  isPublic      Boolean   @default(true)
  sortOrder     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  deletedBy     String?

  subscriptions Subscription[]

  @@index([slug, isPublic, sortOrder])
  @@index([active, isPublic, deletedAt])
  @@map("plans")
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  plan                 String       @default("free")
  planId               String?      @default("plan_free")
  planRel              Plan?        @relation(fields: [planId], references: [id])
  status               String       @default("active")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean      @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
  deletedBy            String?

  @@index([stripeSubscriptionId])
  @@index([plan])
  @@index([organizationId, plan])
  @@map("subscriptions")
}

model Invoice {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeInvoiceId String?
  amount          Int
  currency        String       @default("eur")
  status          String
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?
  downloadUrl     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  deletedBy       String?

  @@index([organizationId])
  @@map("invoices")
}

model UsageRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric         String
  current        Int          @default(0)
  limit          Int
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  @@unique([organizationId, metric])
  @@index([periodEnd])
  @@index([organizationId, metric, periodEnd])
  @@map("usage_records")
}

model SsoConfig {
  id                String        @id @default(cuid())
  organizationId    String        @unique
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain            String?
  idpMetadataUrl    String?
  idpEntityId       String?
  idpSsoUrl         String?
  idpCertificate    String?
  jitProvisioning   Boolean       @default(true)
  jitDefaultRoleId  String?
  active            Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  deletedBy         String?

  @@index([domain, active])
  @@map("sso_configs")
}
