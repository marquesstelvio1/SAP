{
  "name": "@saptm/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "seed:local-admin": "tsx src/local-admin-seed.ts"
  },
  "dependencies": {
    "@saptm/config": "workspace:*",
    "@saptm/database": "workspace:*",
    "@saptm/observability": "workspace:*",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@saptm/tsconfig": "workspace:*",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
