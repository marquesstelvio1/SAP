NODE_ENV=development

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# API
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:25432/saptm

# Cache
REDIS_URL=redis://localhost:26379

# Better Auth
BETTER_AUTH_SECRET=replace-with-local-development-secret
BETTER_AUTH_URL=http://localhost:3000
SAPTM_INVITATION_TOKEN_TTL_HOURS=48

# Email (Resend)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=SAPTM <noreply@saptm.app>

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Observability
OTEL_SERVICE_NAME=saptm
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-grafana-admin-password
