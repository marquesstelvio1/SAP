{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["apps/api/src/main.ts", "apps/web/next.config.ts", "packages/*/src/index.ts"],
  "project": ["apps/**/*.ts", "packages/**/*.ts"],
  "ignoreDependencies": [
