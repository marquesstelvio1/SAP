{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@saptm/auth": ["packages/auth/src/index.ts"],
      "@saptm/config": ["packages/config/src/index.ts"],
      "@saptm/database": ["packages/database/src/index.ts"],
      "@saptm/observability": ["packages/observability/src/index.ts"],
      "@saptm/rpc": ["packages/rpc/src/index.ts"],
      "@saptm/testing": ["packages/testing/src/index.ts"],
      "@saptm/types": ["packages/types/src/index.ts"],
      "@saptm/ui": ["packages/ui/src/index.ts"],
      "@saptm/ui/*": ["packages/ui/src/*"]
    }
  }
}
