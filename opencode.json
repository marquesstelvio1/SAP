{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.better-auth.com/mcp",
      "enabled": true
    },
    "prisma": {
      "type": "remote",
      "url": "https://mcp.prisma.io/mcp",
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "permission": {
        "task": {
          "enterprise-*": "allow"
        },
        "skill": {
          "enterprise-*": "allow",
          "context7-mcp": "allow"
        },
        "tool": {
          "context7_*": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "enterprise-*": "allow"
        },
        "skill": {
          "enterprise-*": "allow",
          "context7-mcp": "allow"
        },
        "tool": {
          "context7_*": "allow"
        }
      }
    }
  }
}
